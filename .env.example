# =====================================================================
# Drone Delivery MVP - copy this file to ".env" and edit it.
# .env holds SMS credentials: never commit it or share it.
# Comments must be on their own line.
# =====================================================================

# ---------- Identity / phone numbers (E.164 format: +<country><number>) ----------
DRONE_ID=DRONE-001
# Warehouse / logistics operator who receives the warehouse SMS
WAREHOUSE_PHONE=+910000000002
# Used when the bridge has to create a delivery itself (demo, or a flight with no prepared delivery)
DEFAULT_CUSTOMER_NAME=Demo Customer
DEFAULT_CUSTOMER_PHONE=+910000000001

# ---------- Backend (FastAPI + SQLite) ----------
API_HOST=0.0.0.0
API_PORT=8000
DB_PATH=backend/data/deliveries.db
# Where the bridge reaches the backend (same PC)
API_BASE_URL=http://127.0.0.1:8000

# ---------- MAVLink input ----------
# Telemetry radio on a USB serial port (what you use now). Find the number in
# Device Manager > Ports (COM & LPT). Windows lets only ONE program open a COM port:
# close Mission Planner's connection to that port (or let it keep the port and see README section 5.1).
MAVLINK_CONNECTION=COM5
# Must match the radio / SERIALx_BAUD on the flight controller (SiK radios: 57600)
MAVLINK_BAUD=57600
# Other options for MAVLINK_CONNECTION:
#   udpin:0.0.0.0:14551   a copy forwarded by Mission Planner (Ctrl+F > MAVLink) or MAVProxy
#   C:/logs/flight.tlog   a recorded flight
# TARGET_SYSTEM_ID: 0 = lock onto the first ArduPilot autopilot heard
TARGET_SYSTEM_ID=0

# ---------- TEMPORARY: notify as soon as the drone is armed ----------
# true  = arming counts as "package picked up / departed": the app and the SMS show the first
#         step immediately (the same messages the mission start used to send)
# false = wait for the real takeoff (altitude / mission progress)
DEPART_ON_ARM=true

# ---------- Mission layout ----------
# Recommended: the mission you saved from Mission Planner (PLAN screen > Save File).
# The bridge reads the takeoff, delivery waypoint, DO_SET_SERVO and RTL item numbers
# and the servo channel + release PWM from it.
MISSION_FILE=mission/delivery_mission.waypoints
# ...or set / override them explicitly (item numbers as shown in Mission Planner):
# TAKEOFF_SEQ=1
# DELIVERY_WP_SEQ=3
# RELEASE_SEQ=4
# RTL_SEQ=5
# DO_SET_SERVO "Ser No" and "PWM" of the release command:
# RELEASE_SERVO_CHANNEL=9
# RELEASE_SERVO_PWM=1900
RELEASE_PWM_TOLERANCE=100
# Count "mission passed the DO_SET_SERVO item" as release evidence when neither the
# servo PWM nor the STATUSTEXT arrived (weaker evidence, see README section 6)
RELEASE_SEQ_FALLBACK=true
# Relative altitude (m) that counts as airborne
TAKEOFF_ALT_M=1.5

# ---------- SMS ----------
# mock = print + log to pc_bridge/data/sms_outbox.log (nothing is sent)
# twilio = real SMS
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number (E.164), or leave empty and use a Messaging Service SID
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ---------- Demo mode ----------
# One simulated mission takes about 8 x this many seconds
DEMO_STEP_SECONDS=6

LOG_LEVEL=INFO
BRIDGE_DATA_DIR=pc_bridge/data
